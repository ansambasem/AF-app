{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "node --test tests/Unit/*.test.js",
        "test:browser": "node tests/Browser/run.mjs",
        "test:print": "node tests/Browser/run.mjs --print",
        "test:readings": "node tests/Browser/run.mjs --readings",
        "check:release": "npm run check -- --apk && npm run test:browser && npm run test:print && npm run test:readings",
        "check": "node .claude/automation/check.mjs --full",
        "check:changed": "node .claude/automation/check.mjs --changed",
        "check:watch": "node .claude/automation/watch.mjs",
        "check:status": "node .claude/automation/check.mjs --status"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.1",
        "@vitejs/plugin-react": "^6.1.1",
        "exceljs": "^4.4.0",
        "pdfjs-dist": "6.4.299",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    }
}
